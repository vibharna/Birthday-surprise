<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday!</title>

<style>
body {
  margin: 0;
  padding: 30px 15px;
  text-align: center;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #ffe0ec, #fff5f8);
  color: #a52a65;
}
.card {
  max-width: 400px;
  margin: 30px auto;
  padding: 25px 15px;
  background: white;
  border-radius: 25px;
  box-shadow: 0 5px 20px #e7a6c5;
}
h1 { color: #ed4b91; }
button {
  background: #ed4b91;
  color: white;
  border: none;
  border-radius: 25px;
  padding: 14px 22px;
  font-size: 17px;
}
#surprise {
  display: none;
  line-height: 1.8;
  margin-top: 20px;
}
.heart {
  font-size: 30px;
  animation: beat 1s infinite alternate;
}
@keyframes beat {
  to { transform: scale(1.3); }
}
</style>
</head>

<body>
<div class="card">
  <div class="heart">💖 🎂 💖</div>
  <h1>Happy Birthday!</h1>
  <p>Today is a special day because it's YOUR day! 🎉</p>

  <button onclick="showSurprise()">
    Tap for a Surprise 🎁
  </button>

  <div id="surprise">
    <h2>🎀 A Special Wish for You 🎀</h2>
    <p>
      Happy Birthday, my dear friend! ❤️<br>
      Thank you for being a beautiful part of my life.
      May your days be filled with happiness, laughter,
      love, and wonderful memories. 🥹💕
    </p>
    <p>Stay happy and keep smiling! 🌷</p>
  </div>

  <p>Made with ❤️ just for you</p>
</div>

<script>
function showSurprise() {
  document.getElementById("surprise").style.display = "block";
}
</script>
</body>
</html>
